{
  "source": "src/secondlook/demo/capsule.json",
  "results": "site/demo/summary.json",
  "kind": "offline_reference",
  "checks": [
    {
      "id": "initial",
      "name": "All six feedback items render",
      "actions": [],
      "assert": {
        "selector": ".card",
        "count": 6
      },
      "originalPassed": true,
      "referencePassed": true,
      "reportId": "check-1"
    },
    {
      "id": "priority",
      "name": "Priority filter keeps the two P1 items",
      "actions": [
        {
          "type": "select",
          "selector": "#priority",
          "value": "P1"
        }
      ],
      "assert": {
        "selector": ".card",
        "count": 2
      },
      "originalPassed": true,
      "referencePassed": true,
      "reportId": "check-2"
    },
    {
      "id": "search",
      "name": "Lowercase search finds uppercase CSV title",
      "actions": [
        {
          "type": "fill",
          "selector": "#search",
          "value": "csv"
        }
      ],
      "assert": {
        "selector": ".card h2",
        "text": "CSV export includes hidden items"
      },
      "capture": true,
      "originalPassed": false,
      "referencePassed": true,
      "reportId": "check-3"
    },
    {
      "id": "export",
      "name": "CSV contains exactly the filtered visible item",
      "actions": [
        {
          "type": "fill",
          "selector": "#search",
          "value": "Keyboard"
        },
        {
          "type": "download",
          "selector": "#export"
        }
      ],
      "assert": {
        "csv": [
          [
            "id",
            "title",
            "priority",
            "tag"
          ],
          [
            "F-104",
            "Keyboard shortcut for search",
            "P2",
            "accessibility"
          ]
        ]
      },
      "originalPassed": false,
      "referencePassed": true,
      "reportId": "check-4"
    },
    {
      "id": "quoting",
      "name": "CSV preserves commas, quotes and multiline titles",
      "actions": [
        {
          "type": "fill",
          "selector": "#search",
          "value": "Billing"
        },
        {
          "type": "download",
          "selector": "#export"
        }
      ],
      "assert": {
        "csv": [
          [
            "id",
            "title",
            "priority",
            "tag"
          ],
          [
            "F-105",
            "Billing, \"team\" plan\nneeds invoice",
            "P1",
            "payments"
          ]
        ]
      },
      "originalPassed": false,
      "referencePassed": true,
      "reportId": "check-5"
    },
    {
      "id": "whitespace",
      "name": "Mixed case and surrounding whitespace work together",
      "held_out": true,
      "actions": [
        {
          "type": "fill",
          "selector": "#search",
          "value": "  bIlLiNg  "
        },
        {
          "type": "select",
          "selector": "#priority",
          "value": "P1"
        }
      ],
      "assert": {
        "selector": ".card",
        "count": 1
      },
      "originalPassed": false,
      "referencePassed": true,
      "reportId": "check-6"
    },
    {
      "id": "reset",
      "name": "Reset restores the whole inbox",
      "actions": [
        {
          "type": "fill",
          "selector": "#search",
          "value": "Keyboard"
        },
        {
          "type": "select",
          "selector": "#priority",
          "value": "P1"
        },
        {
          "type": "click",
          "selector": "#reset"
        }
      ],
      "assert": {
        "selector": "#count",
        "text": "6 of 6 items"
      },
      "originalPassed": true,
      "referencePassed": true,
      "reportId": "check-7"
    },
    {
      "id": "empty-export",
      "name": "Empty result exports only the CSV header",
      "held_out": true,
      "actions": [
        {
          "type": "fill",
          "selector": "#search",
          "value": "does-not-exist"
        },
        {
          "type": "download",
          "selector": "#export"
        }
      ],
      "assert": {
        "csv": [
          [
            "id",
            "title",
            "priority",
            "tag"
          ]
        ]
      },
      "originalPassed": false,
      "referencePassed": true,
      "reportId": "check-8"
    }
  ]
}
